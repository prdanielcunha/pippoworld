{
  "name": "pippo-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test:smoke": "playwright test --project=chromium",
    "test:webkit": "playwright test --project=webkit",
    "validate": "npm run build && npm run test:smoke"
  },
  "dependencies": { "@babylonjs/core": "9.32.0" },
  "devDependencies": { "@playwright/test": "1.64.1", "typescript": "7.0.2", "vite": "8.3.5" }
}
